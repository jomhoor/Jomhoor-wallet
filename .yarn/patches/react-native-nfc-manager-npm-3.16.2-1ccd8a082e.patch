+    NSMutableDictionary *details = [@{
+        @"tagType": [self nidNfcTagType:tag],
+        @"available": tag.available ? @"true" : @"false",
+    } mutableCopy];
+
+    if (tag.type == NFCTagTypeISO7816Compatible) {
+        id<NFCISO7816Tag> iso7816Tag = [tag asNFCISO7816Tag];
+        details[@"initialSelectedAidLength"] = @(iso7816Tag.initialSelectedAID.length);
+        details[@"historicalBytesLength"] = @(iso7816Tag.historicalBytes.length);
+        details[@"applicationDataLength"] = @(iso7816Tag.applicationData.length);
+    }
+    return details;
+}
