+- (void)nidNfcLog:(NSString *)event details:(NSDictionary *)details
+{
+#if DEBUG
+    NSMutableArray<NSString *> *parts = [NSMutableArray arrayWithArray:@[
+        [NSString stringWithFormat:@"event=%@", event],
+        [NSString stringWithFormat:@"sessionId=%@", nidNfcSessionId ?: @"none"],
+        [NSString stringWithFormat:@"elapsedMs=%.0f", [self nidNfcElapsedMs]],
+        [NSString stringWithFormat:@"mainThread=%@", NSThread.isMainThread ? @"true" : @"false"],
+        [NSString stringWithFormat:@"appState=%@", [self nidNfcApplicationState]],
+    ]];
+    for (NSString *key in [[details allKeys] sortedArrayUsingSelector:@selector(compare:)]) {
+        NSString *value = [NSString stringWithFormat:@"%@", details[key]];
+        value = [value stringByReplacingOccurrencesOfString:@"\n" withString:@"_"];
+        value = [value stringByReplacingOccurrencesOfString:@";" withString:@"_"];
+        [parts addObject:[NSString stringWithFormat:@"%@=%@", key, value]];
+    }
+    NSLog(@"[NidNfcIOS] %@", [parts componentsJoinedByString:@"; "]);
+#else
+    (void)event;
+    (void)details;
+#endif
+}
