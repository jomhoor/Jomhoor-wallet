{
  "name": "@iland/passport-verification",
  "private": true,
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./passport": {
      "types": "./dist/passport/index.d.ts",
      "import": "./dist/passport/index.js",
      "require": "./dist/passport/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test:vectors": "node ./tests/mrz-access-key-vectors.cjs"
  },
  "devDependencies": {
    "typescript": "~5.7.3"
  }
}
